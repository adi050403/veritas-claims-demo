# Backend: local | gcp
STORAGE_BACKEND=local

# Local paths (used when STORAGE_BACKEND=local)
LOCAL_RAW_ROOT=./sample-data
LOCAL_STATE_ROOT=./data/state
LOCAL_QUARANTINE_ROOT=./data/quarantine
LOCAL_DB_PATH=./data/db/veritas.sqlite
CONFIG_ROOT=./config

# GCP (used when STORAGE_BACKEND=gcp)
GCP_PROJECT_ID=
GCS_RAW_BUCKET=veritas-medical-raw
GCS_STATE_BUCKET=veritas-medical-raw
GCS_QUARANTINE_PREFIX=quarantine/
BQ_DATASET=veritas_claims_demo
BQ_TABLE=canonical_records
BQ_DEADLETTER_TABLE=dead_letter
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini — prefer Developer API (API key). Vertex often 404s without Model Garden access.
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-3.7-flash
GEMINI_USE_VERTEX=false
GEMINI_API_KEY=
VERTEX_LOCATION=global

# Pipeline
FUZZY_MATCH_THRESHOLD=86
NLP_MATCH_THRESHOLD=0.78
LOG_LEVEL=INFO
