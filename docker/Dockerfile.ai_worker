FROM python:3.11-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY config ./config
COPY src ./src
COPY scripts ./scripts

ENV PYTHONPATH=/app/src
ENV STORAGE_BACKEND=gcp

# Cloud Run Job entrypoint — small batch keeps free-tier Gemini quota healthy
CMD ["python", "scripts/run_ai_worker.py", "--limit", "5", "--backend", "gcp"]
