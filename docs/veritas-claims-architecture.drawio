        <mxCell id="1 23" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;GCS quarantine + BQ dead_letter&lt;/b&gt;&lt;br&gt;raw file + stage + reason + correlation_id" vertex="1">
