          <mxGeometry height="55" width="295" x="438" y="365" as="geometry" />
        </mxCell>
        <mxCell id="1 17" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;4 Standardise&lt;/b&gt;&lt;br&gt;test names (exact→fuzzy→Gemini) · numeric · units · dates/age/gender · medicines" vertex="1">
          <mxGeometry height="55" width="295" x="438" y="430" as="geometry" />
        </mxCell>
        <mxCell id="1 18" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;5 Validate&lt;/b&gt;&lt;br&gt;range · outlier · unit-family check · Test_Analytics" vertex="1">
          <mxGeometry height="55" width="295" x="438" y="495" as="geometry" />
        </mxCell>
        <mxCell id="1 19" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;6 Write&lt;/b&gt;&lt;br&gt;micro-batch → BigQuery staging, MERGE" vertex="1">
          <mxGeometry height="55" width="295" x="438" y="560" as="geometry" />
        </mxCell>
        <mxCell id="1 20" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=45;dashed=1;" value="&lt;b&gt;3 · STORAGE&lt;/b&gt;" vertex="1">
          <mxGeometry height="440" width="280" x="1000" y="200" as="geometry" />
        </mxCell>
        <mxCell id="1 21" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;BigQuery – analytics store&lt;/b&gt;&lt;br&gt;staging → MERGE → curated&lt;br&gt;lab_results + medications (long, 50-col schema)&lt;br&gt;partition reports_date · cluster test_name_canonical, claim_no&lt;br&gt;report_wide VIEW (5 cols/test)" vertex="1">
          <mxGeometry height="135" width="260" x="1010" y="235" as="geometry" />
        </mxCell>
        <mxCell id="1 22" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;Cloud SQL (Postgres) – control plane&lt;/b&gt;&lt;br&gt;processed_docs (hashes) · alias store&lt;br&gt;review queue · pipeline_runs · clinic stats" vertex="1">
          <mxGeometry height="110" width="260" x="1010" y="395" as="geometry" />
