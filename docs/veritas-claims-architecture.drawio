<mxfile host="app.diagrams.net" pages="3">
  <diagram id="p1" name="1 - Solution Architecture">
    <mxGraphModel dx="858" dy="468" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1550" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="1 2" parent="1" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontSize=12;" value="&lt;b&gt;Veritas Claims – Medical Data Standardisation Pipeline (GCP · Python)&lt;/b&gt;&lt;br&gt;Event-driven micro-batch · raw JSON kept (schema-on-read) + curated long table (schema-on-write) · config-driven, zero-code clinic onboarding" vertex="1">
          <mxGeometry height="55" width="1400" x="20" y="5" as="geometry" />
        </mxCell>
        <mxCell id="1 3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacing=6;" value="&lt;b&gt;Key design choices&lt;/b&gt;&lt;br&gt;• Micro-batch, event-driven (not true streaming)&lt;br&gt;• Raw JSON retained → full audit trail&lt;br&gt;• Config in Git: new clinic = YAML PR, no deploy&lt;br&gt;• Gemini only for names the cascade cannot resolve; results cached" vertex="1">
          <mxGeometry height="110" width="380" x="20" y="70" as="geometry" />
        </mxCell>
        <mxCell id="1 4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;CONFIG LAYER (versioned)&lt;/b&gt;&lt;br&gt;Git repo (YAML): source mappings · test registry (aliases, units, ranges, plausible bounds) · medicines · dedup keys&lt;br&gt;Cloud Build → GCS config bucket · workers load &amp; cache by version" vertex="1">
          <mxGeometry height="110" width="330" x="420" y="70" as="geometry" />
        </mxCell>
        <mxCell id="1 5" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Vertex AI – Gemini Flash&lt;/b&gt;&lt;br&gt;Unresolved test / medicine names only&lt;br&gt;Batched · JSON-schema constrained&lt;br&gt;Constrained to canonical list · cached" vertex="1">
          <mxGeometry height="110" width="230" x="780" y="70" as="geometry" />
        </mxCell>
        <mxCell id="1 6" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;opacity=45;dashed=1;" value="&lt;b&gt;SOURCES&lt;/b&gt;" vertex="1">
          <mxGeometry height="440" width="170" x="10" y="200" as="geometry" />
        </mxCell>
        <mxCell id="1 7" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" value="&lt;b&gt;500+ Clinics / Labs&lt;/b&gt;&lt;br&gt;JSON via upstream extraction&lt;br&gt;(source_system e.g. FASTTRACK)&lt;br&gt;SFTP · signed-URL upload" vertex="1">
          <mxGeometry height="130" width="150" x="20" y="330" as="geometry" />
        </mxCell>
        <mxCell id="1 8" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=45;dashed=1;" value="&lt;b&gt;1 · INGESTION&lt;/b&gt;" vertex="1">
          <mxGeometry height="440" width="210" x="190" y="200" as="geometry" />
        </mxCell>
        <mxCell id="1 9" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;GCS raw bucket&lt;/b&gt;&lt;br&gt;/{clinic_id}/{yyyy-mm-dd}/file.json&lt;br&gt;immutable · lifecycle rules" vertex="1">
          <mxGeometry height="90" width="180" x="205" y="240" as="geometry" />
        </mxCell>
        <mxCell id="1 10" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Pub/Sub: file-arrived&lt;/b&gt;&lt;br&gt;GCS object-finalize notification&lt;br&gt;buffers bursts · at-least-once" vertex="1">
          <mxGeometry height="80" width="180" x="205" y="360" as="geometry" />
        </mxCell>
        <mxCell id="1 11" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;Pub/Sub DLQ&lt;/b&gt;&lt;br&gt;after N retries" vertex="1">
          <mxGeometry height="50" width="180" x="205" y="470" as="geometry" />
        </mxCell>
        <mxCell id="1 12" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Cloud Scheduler&lt;/b&gt;&lt;br&gt;periodic sweep for missed files (batch mode)" vertex="1">
          <mxGeometry height="70" width="180" x="205" y="550" as="geometry" />
        </mxCell>
        <mxCell id="1 13" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;opacity=45;dashed=1;" value="&lt;b&gt;2 · PROCESSING – Cloud Run (Python), autoscaled&lt;/b&gt;" vertex="1">
          <mxGeometry height="440" width="330" x="420" y="200" as="geometry" />
        </mxCell>
        <mxCell id="1 14" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;1 Parse &amp; envelope check&lt;/b&gt;&lt;br&gt;malformed JSON → dead-letter" vertex="1">
