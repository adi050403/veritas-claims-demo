        </mxCell>
        <mxCell id="1 15" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;2 Dedup&lt;/b&gt;&lt;br&gt;payload content-hash (configurable)" vertex="1">
